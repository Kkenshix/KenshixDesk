{
  "manifest_version": 3,
  "name": "KenshixDeck Video",
  "version": "1.2.0",
  "description": "Opera’daki video karelerini eşleştirilmiş M22’ye yerel olarak gönderir.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "worker.js"},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["video.js"],
    "all_frames": true,
    "match_origin_as_fallback": true,
    "run_at": "document_idle"
  }]
}
