{
  "manifest_version": 3,
  "name": "KenshixDeck Video",
  "version": "1.1.1",
  "description": "Opera’daki video karelerini eşleştirilmiş M22’ye yerel olarak gönderir.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "worker.js"},
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*", "https://www.kick.com/*", "https://kick.com/*"],
    "js": ["video.js"],
    "run_at": "document_idle"
  }]
}
